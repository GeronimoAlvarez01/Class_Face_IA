{
  "expo": {
    "name": "Asistencia Facial",
    "slug": "asistencia-facial",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "co.edu.asistencia.facial",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa para reconocer a los estudiantes y tomar la asistencia."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e74bc476-76e0-46f3-80d3-2a109154cf99"
      }
    }
  }
}
