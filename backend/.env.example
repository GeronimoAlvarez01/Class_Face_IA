# Copie este archivo como .env  (Mac: cp .env.example .env  |  Windows: copy .env.example .env)

PORT=3000
TIMEZONE=America/Bogota

# Clave que la app debe enviar en el encabezado x-api-key. Defínala antes de usar la API en una red compartida.
ADMIN_TOKEN=

# http = servicio Python real (Parte 3)  |  mock = simulado, SOLO para desarrollar la app (reconoce siempre al primero)
RECOGNITION_MODE=mock
RECOGNITION_URL=http://127.0.0.1:8001

# true = permite tomar asistencia cualquier día. Útil para probar; en producción déjelo en false.
ALLOW_ANY_DAY=true
